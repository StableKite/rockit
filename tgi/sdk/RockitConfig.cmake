set(ROCKIT_FILE_CONFIGS "${CMAKE_CURRENT_LIST_DIR}/conf")
set(ROCKIT_FILE_HEADERS "${CMAKE_CURRENT_LIST_DIR}/include")

if(TARGET Rockit::rockit)
    set(ROCKIT_DEP_COMMON_LIBS Rockit::rockit)
    set(ROCKIT_FILE_LIBS Rockit::rockit)
else()
    find_library(ROCKIT_LIBRARY NAMES rockit REQUIRED)
    set(ROCKIT_DEP_COMMON_LIBS "${ROCKIT_LIBRARY}")
    set(ROCKIT_FILE_LIBS "${ROCKIT_LIBRARY}")
endif()
